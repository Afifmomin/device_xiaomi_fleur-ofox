# fstab
system                                     /system          erofs               ro wait,slotselect,logical
system                                     /system          ext4                ro wait,slotselect,logical
system_ext                                 /system_ext      erofs               ro wait,slotselect,logical,nofail
system_ext                                 /system_ext      ext4                ro wait,slotselect,logical,nofail
vendor                                     /vendor          erofs               ro wait,slotselect,logical
vendor                                     /vendor          ext4                ro wait,slotselect,logical
product                                    /product         erofs               ro wait,slotselect,logical
product                                    /product         ext4                ro wait,slotselect,logical
odm                                        /odm             erofs               ro wait,slotselect,logical
odm                                        /odm             ext4                ro wait,slotselect,logical

/dev/block/by-name/metadata                /metadata        ext4                noatime,nosuid,nodev,discard,sync                    wait,check,formattable,first_stage_mount

/dev/block/by-name/userdata                /data            f2fs                noatime,nosuid,nodev,discard,noflush_merge,fsync_mode=nobarrier,reserve_root=32768,resgid=1065,inlinecrypt wait,check,formattable,latemount,reservedsize=128m,checkpoint=fs,fileencryption=aes-256-xts:aes-256-cts:v2+inlinecrypt_optimized,keydirectory=/metadata/vold/metadata_encryption,fsverity

/dev/block/platform/bootdevice/by-name/misc /misc           emmc                defaults       defaults

/dev/block/by-name/boot                    /boot            emmc                defaults       slotselect
